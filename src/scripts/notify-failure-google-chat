# Google Chat provider for notify-failure. Posts into the deploy thread, then
# again as a message of its own so it shows in the space, the webhook version
# of a Slack reply broadcast. Webhooks cannot react or DM.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: notify-failure-google-chat <message>" >&2
  echo "Error: message argument required" >&2
  exit 42
fi

message="$*"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=src/scripts/lib/notify-google-chat.bash
source "${script_dir}/lib/notify-google-chat.bash"

text="$(google_chat_prefix Failure)${message}"

failed=false
google_chat_thread_post "${text}" || failed=true
google_chat_send googleChatWebhookUrl "" "${text}" || failed=true
[[ "${failed}" == "false" ]]
