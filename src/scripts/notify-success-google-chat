# Google Chat provider for notify-success. Posts into the deploy thread. Webhooks
# cannot react, so the prefix is what marks the outcome, and with
# googleChatSuccessToChannel set to true it is also posted on its own so it
# shows in the space, as failure always is.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: notify-success-google-chat <message>" >&2
  echo "Error: message argument required" >&2
  exit 42
fi

message="$*"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=src/scripts/lib/notify-google-chat.bash
source "${script_dir}/lib/notify-google-chat.bash"

text="$(google_chat_prefix Success)${message}"

failed=false
google_chat_thread_post "${text}" || failed=true
if [[ "$(google_chat_setting googleChatSuccessToChannel)" == "true" ]]; then
  google_chat_send googleChatWebhookUrl "" "${text}" || failed=true
fi
[[ "${failed}" == "false" ]]
