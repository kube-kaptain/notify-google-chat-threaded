# Validate that the tooling the Google Chat notify providers need is present.
# Run by validate-tooling during deploy image builds and before each deploy.
set -euo pipefail

failures=0

for name in curl yq; do
  if command -v "${name}" &> /dev/null; then
    echo "  OK: ${name} (google-chat)"
  else
    echo "  MISSING: ${name} (google-chat)" >&2
    failures=$((failures + 1))
  fi
done

[[ "${failures}" -eq 0 ]]
