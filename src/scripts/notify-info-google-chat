# Google Chat provider for notify-info. Posts into the deploy thread, starting
# it if this is the first message of the run.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: notify-info-google-chat <message>" >&2
  echo "Error: message argument required" >&2
  exit 42
fi

message="$*"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=src/scripts/lib/notify-google-chat.bash
source "${script_dir}/lib/notify-google-chat.bash"

google_chat_thread_post "$(google_chat_prefix Info)${message}"
